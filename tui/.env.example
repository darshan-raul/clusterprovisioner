# Strata TUI config

# MiniMax (OpenAI-compatible) — required for the chat rail
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MODEL=MiniMax-M3
TEMPERATURE=0.2

# Strata backend orchestrator. Phase 1 dev: port-forwarded at :8080
STRATA_BACKEND_URL=http://localhost:8080

# Keycloak. Phase 1 dev: port-forwarded at :8081
STRATA_KEYCLOAK_URL=http://localhost:8081
STRATA_KEYCLOAK_REALM=strata-dev
STRATA_KEYCLOAK_CLIENT_ID=strata-tui